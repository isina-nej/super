# Copy to .env and fill in secrets before `docker compose up --build`

# --- Telegram ---
BOT_TOKEN=
# From https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Local Bot API base (used by bot service inside compose)
TELEGRAM_BOT_API_URL=http://telegram-bot-api:8081

# Empty = allow all users (dev). Production: comma-separated Telegram user IDs
ALLOWED_TELEGRAM_IDS=

# Shared secret between bot and Django API (Authorization: Bearer …)
INTERNAL_API_TOKEN=change-me-to-a-long-random-string

# --- Django ---
DJANGO_SECRET_KEY=change-me-django-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
MEDIA_ROOT=/media
MAX_FILE_SIZE_BYTES=2147483648
MAX_CONCURRENT_JOBS_PER_USER=8

# --- MySQL ---
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=download_bot
MYSQL_USER=bot
MYSQL_PASSWORD=botpass
MYSQL_HOST=mysql
MYSQL_PORT=3306

# --- Redis / Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Browser cookies for age-gated sites (JSON export or Netscape cookies.txt)
# Place the file in ./cookies/ (gitignored). Worker reads /cookies/cookies.json
YTDLP_COOKIES_FILE=/cookies/cookies.json
# Optional: comma-separated hosts kept from a full-browser JSON dump
# YTDLP_COOKIE_DOMAINS=pornhub.com,youtube.com

# Optional HTTP/SOCKS proxy for sites that block datacenter IPs (PornHub, etc.)
# Example: socks5://user:pass@host:1080
YTDLP_PROXY=

# --- Bot polling ---
API_BASE_URL=http://api:8000/api/v1
POLL_INTERVAL_SECONDS=2
POLL_TIMEOUT_SECONDS=1800

# --- Optional host ports ---
API_PUBLISH_PORT=8000
MYSQL_PUBLISH_PORT=3306
REDIS_PUBLISH_PORT=6379
TELEGRAM_BOT_API_PUBLISH_PORT=8081
